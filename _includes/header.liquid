<header class="site-header">
  <div class="header-left">
    <a class="wordmark" href="{{ "/" | relative_url }}">{{ site.title }}</a>
  </div>
  <nav class="site-nav" aria-label="Main">
    <ul>
      {% for item in site.menu %}
      <li><a href="{{ item.url | relative_url }}">{{ item.name }}</a></li>
      {% endfor %}
    </ul>
  </nav>
</header>
